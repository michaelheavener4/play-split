{
  "manifest_version": 3,
  "name": "play-split captions",
  "version": "1.0",
  "description": "Reports YouTube caption on/off state to play-split",
  "key": "",
  "permissions": ["nativeMessaging"],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://youtube.com/*",
        "*://youtu.be/*",
        "*://*.youtube-nocookie.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
